{
  "openapi": "3.1.0",
  "info": {
    "title": "PoolRotater staging M3 hub",
    "version": "1.0.0",
    "description": "Core M3 endpoints with explicit HTTPS, no remote admin/provider authorization/room control. Bodies <=65536 bytes. Optional M4 extension is documented in RATINGS_API_V1.json and requires explicit migration/grants."
  },
  "paths": {
    "/v1/capabilities": {
      "get": {
        "description": "Protocol limits; no authority",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Closed contract refusal"
          },
          "401": {
            "description": "Missing/expired credential or invitation"
          },
          "403": {
            "description": "Revoked or mismatched authority"
          },
          "409": {
            "description": "Conflict or replay refusal"
          },
          "429": {
            "description": "Bounded quota; Retry-After: 5"
          },
          "503": {
            "description": "Hub/storage unavailable"
          }
        },
        "security": []
      }
    },
    "/v1/enrollments": {
      "post": {
        "description": "Redeem bound invitation with durable request ID",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Closed contract refusal"
          },
          "401": {
            "description": "Missing/expired credential or invitation"
          },
          "403": {
            "description": "Revoked or mismatched authority"
          },
          "409": {
            "description": "Conflict or replay refusal"
          },
          "429": {
            "description": "Bounded quota; Retry-After: 5"
          },
          "503": {
            "description": "Hub/storage unavailable"
          }
        },
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Enrollment"
              }
            }
          }
        }
      }
    },
    "/v1/hosts/self": {
      "get": {
        "description": "Authenticated host status",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Closed contract refusal"
          },
          "401": {
            "description": "Missing/expired credential or invitation"
          },
          "403": {
            "description": "Revoked or mismatched authority"
          },
          "409": {
            "description": "Conflict or replay refusal"
          },
          "429": {
            "description": "Bounded quota; Retry-After: 5"
          },
          "503": {
            "description": "Hub/storage unavailable"
          }
        },
        "security": [
          {
            "hostCredential": []
          }
        ]
      }
    },
    "/v1/hosts/self/heartbeat": {
      "post": {
        "description": "Monotonic room observation; replay never refreshes receipt",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Closed contract refusal"
          },
          "401": {
            "description": "Missing/expired credential or invitation"
          },
          "403": {
            "description": "Revoked or mismatched authority"
          },
          "409": {
            "description": "Conflict or replay refusal"
          },
          "429": {
            "description": "Bounded quota; Retry-After: 5"
          },
          "503": {
            "description": "Hub/storage unavailable"
          }
        },
        "security": [
          {
            "hostCredential": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Heartbeat"
              }
            }
          }
        }
      }
    },
    "/v1/hosts/self/token-rotation": {
      "post": {
        "description": "Rotate with durable request ID; exact lost-reply retry allowed",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Closed contract refusal"
          },
          "401": {
            "description": "Missing/expired credential or invitation"
          },
          "403": {
            "description": "Revoked or mismatched authority"
          },
          "409": {
            "description": "Conflict or replay refusal"
          },
          "429": {
            "description": "Bounded quota; Retry-After: 5"
          },
          "503": {
            "description": "Hub/storage unavailable"
          }
        },
        "security": [
          {
            "hostCredential": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Rotation"
              }
            }
          }
        }
      }
    },
    "/v1/hosts/self/leave": {
      "post": {
        "description": "Revoke host and hide rooms",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Closed contract refusal"
          },
          "401": {
            "description": "Missing/expired credential or invitation"
          },
          "403": {
            "description": "Revoked or mismatched authority"
          },
          "409": {
            "description": "Conflict or replay refusal"
          },
          "429": {
            "description": "Bounded quota; Retry-After: 5"
          },
          "503": {
            "description": "Hub/storage unavailable"
          }
        },
        "security": [
          {
            "hostCredential": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Leave"
              }
            }
          }
        }
      }
    },
    "/v1/rooms": {
      "get": {
        "description": "Paged public directory; stale at180s, absent at600s",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Closed contract refusal"
          },
          "401": {
            "description": "Missing/expired credential or invitation"
          },
          "403": {
            "description": "Revoked or mismatched authority"
          },
          "409": {
            "description": "Conflict or replay refusal"
          },
          "429": {
            "description": "Bounded quota; Retry-After: 5"
          },
          "503": {
            "description": "Hub/storage unavailable"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      }
    },
    "/directory": {
      "get": {
        "description": "Escaped HTML directory; same paging/privacy",
        "responses": {
          "200": {
            "description": "Successful bounded response"
          },
          "400": {
            "description": "Closed contract refusal"
          },
          "401": {
            "description": "Missing/expired credential or invitation"
          },
          "403": {
            "description": "Revoked or mismatched authority"
          },
          "409": {
            "description": "Conflict or replay refusal"
          },
          "429": {
            "description": "Bounded quota; Retry-After: 5"
          },
          "503": {
            "description": "Hub/storage unavailable"
          }
        },
        "security": [],
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "Map": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beatmap_id",
          "title",
          "stars"
        ],
        "properties": {
          "beatmap_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "stars": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          }
        }
      },
      "Room": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alias",
          "osu_room_id",
          "preset",
          "state",
          "occupants",
          "visibility",
          "title",
          "min_stars",
          "max_stars",
          "observed_at",
          "code_version",
          "catalog_version",
          "current_map"
        ],
        "properties": {
          "alias": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,23}$"
          },
          "osu_room_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "preset": {
            "enum": [
              "standard-auto",
              "standard-fixed",
              "mania-4k",
              "mania-7k"
            ]
          },
          "state": {
            "enum": [
              "idle",
              "starting",
              "playing",
              "draining",
              "unavailable"
            ]
          },
          "occupants": {
            "type": "integer",
            "minimum": 0,
            "maximum": 128
          },
          "visibility": {
            "const": "public"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          },
          "min_stars": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "max_stars": {
            "type": "number",
            "minimum": 0,
            "maximum": 20
          },
          "observed_at": {
            "type": "number",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "code_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.+-]{1,64}$"
          },
          "catalog_version": {
            "type": "string",
            "pattern": "^(unavailable|[a-f0-9]{64})$"
          },
          "current_map": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Map"
              }
            ]
          }
        }
      },
      "Heartbeat": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "installation_id",
          "generation",
          "sequence",
          "code_version",
          "catalog_version",
          "rooms"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "installation_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "format": "uuid"
          },
          "generation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "format": "uuid"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "code_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.+-]{1,64}$"
          },
          "catalog_version": {
            "type": "string",
            "pattern": "^(unavailable|[a-f0-9]{64})$"
          },
          "rooms": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "$ref": "#/components/schemas/Room"
            }
          }
        }
      },
      "Enrollment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "request_id",
          "invitation",
          "credential",
          "installation_id",
          "generation",
          "operator_id",
          "account_id",
          "directory"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "format": "uuid"
          },
          "invitation": {
            "type": "string",
            "pattern": "^pri_[A-Za-z0-9_-]{43}$"
          },
          "credential": {
            "type": "string",
            "pattern": "^prn_[A-Za-z0-9_-]{43}$"
          },
          "installation_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "format": "uuid"
          },
          "generation": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "format": "uuid"
          },
          "operator_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "format": "uuid"
          },
          "account_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "directory": {
            "type": "boolean"
          }
        }
      },
      "Rotation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version",
          "request_id",
          "credential"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "format": "uuid"
          },
          "credential": {
            "type": "string",
            "pattern": "^prn_[A-Za-z0-9_-]{43}$"
          }
        }
      },
      "Leave": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocol_version"
        ],
        "properties": {
          "protocol_version": {
            "type": "integer",
            "const": 1
          }
        }
      },
      "NetworkConfiguration": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "origin",
          "ca_pem",
          "ca_sha256",
          "operator_id",
          "account_id",
          "directory"
        ],
        "properties": {
          "origin": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^https://"
          },
          "ca_pem": {
            "type": "string",
            "maxLength": 60000
          },
          "ca_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "operator_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "format": "uuid"
          },
          "account_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "directory": {
            "type": "boolean"
          }
        }
      }
    },
    "securitySchemes": {
      "hostCredential": {
        "type": "http",
        "scheme": "bearer",
        "description": "Independent prn_ network credential; never osu OAuth"
      }
    }
  }
}
