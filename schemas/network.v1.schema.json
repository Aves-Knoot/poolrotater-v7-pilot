{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:poolrotater:network:v1",
  "title": "PoolRotater M3 protocol v1",
  "description": "Final M3 wire fields; server additionally rejects bool integers, invalid trust/origins, reversed ranges, duplicate aliases/room IDs and future observations. Historical draft heartbeat remains separate.",
  "$defs": {
    "Map": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "beatmap_id",
        "title",
        "stars"
      ],
      "properties": {
        "beatmap_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "stars": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        }
      }
    },
    "Room": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "alias",
        "osu_room_id",
        "preset",
        "state",
        "occupants",
        "visibility",
        "title",
        "min_stars",
        "max_stars",
        "observed_at",
        "code_version",
        "catalog_version",
        "current_map"
      ],
      "properties": {
        "alias": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,23}$"
        },
        "osu_room_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "preset": {
          "enum": [
            "standard-auto",
            "standard-fixed",
            "mania-4k",
            "mania-7k"
          ]
        },
        "state": {
          "enum": [
            "idle",
            "starting",
            "playing",
            "draining",
            "unavailable"
          ]
        },
        "occupants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "visibility": {
          "const": "public"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
        },
        "min_stars": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "max_stars": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "observed_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "code_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]{1,64}$"
        },
        "catalog_version": {
          "type": "string",
          "pattern": "^(unavailable|[a-f0-9]{64})$"
        },
        "current_map": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Map"
            }
          ]
        }
      }
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "installation_id",
        "generation",
        "sequence",
        "code_version",
        "catalog_version",
        "rooms"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "format": "uuid"
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "format": "uuid"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "code_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9.+-]{1,64}$"
        },
        "catalog_version": {
          "type": "string",
          "pattern": "^(unavailable|[a-f0-9]{64})$"
        },
        "rooms": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/Room"
          }
        }
      }
    },
    "Enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "invitation",
        "credential",
        "installation_id",
        "generation",
        "operator_id",
        "account_id",
        "directory"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "format": "uuid"
        },
        "invitation": {
          "type": "string",
          "pattern": "^pri_[A-Za-z0-9_-]{43}$"
        },
        "credential": {
          "type": "string",
          "pattern": "^prn_[A-Za-z0-9_-]{43}$"
        },
        "installation_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "format": "uuid"
        },
        "generation": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "format": "uuid"
        },
        "operator_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "format": "uuid"
        },
        "account_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "directory": {
          "type": "boolean"
        }
      }
    },
    "Rotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version",
        "request_id",
        "credential"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "format": "uuid"
        },
        "credential": {
          "type": "string",
          "pattern": "^prn_[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "Leave": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol_version"
      ],
      "properties": {
        "protocol_version": {
          "type": "integer",
          "const": 1
        }
      }
    },
    "NetworkConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "origin",
        "ca_pem",
        "ca_sha256",
        "operator_id",
        "account_id",
        "directory"
      ],
      "properties": {
        "origin": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^https://"
        },
        "ca_pem": {
          "type": "string",
          "maxLength": 60000
        },
        "ca_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "operator_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "format": "uuid"
        },
        "account_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "directory": {
          "type": "boolean"
        }
      }
    }
  },
  "$ref": "#/$defs/Heartbeat"
}
