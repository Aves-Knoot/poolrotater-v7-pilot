{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://poolrotater.invalid/schemas/ratings.v1.schema.json",
  "$defs": {
    "Context": {
      "type": "object",
      "properties": {
        "ruleset_id": {
          "enum": [
            null,
            0,
            1,
            2,
            3
          ]
        },
        "room_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "playlist_item_id": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "required_mods": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9]{1,8}$"
          },
          "description": "Sorted canonical order; runtime checks ordering."
        }
      },
      "required": [
        "ruleset_id",
        "room_id",
        "playlist_item_id",
        "required_mods"
      ],
      "additionalProperties": false
    },
    "Event": {
      "type": "object",
      "properties": {
        "format": {
          "const": 1
        },
        "event_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "installation_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "kind": {
          "enum": [
            "rating_set",
            "historical_seed"
          ]
        },
        "beatmap_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "rating": {
          "type": "integer",
          "enum": [
            -1,
            0,
            1
          ]
        },
        "base_revision": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "predecessor": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "number",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "map_origin": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "key_count": {
          "enum": [
            null,
            4,
            7
          ]
        },
        "context": {
          "$ref": "#/$defs/Context"
        }
      },
      "required": [
        "format",
        "event_id",
        "installation_id",
        "generation",
        "sequence",
        "kind",
        "beatmap_id",
        "user_id",
        "rating",
        "base_revision",
        "predecessor",
        "observed_at",
        "map_origin",
        "key_count",
        "context"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "historical_seed"
              }
            }
          },
          "then": {
            "properties": {
              "base_revision": {
                "type": "null"
              },
              "predecessor": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "Batch": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "batch_id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/Event"
          }
        }
      },
      "required": [
        "protocol_version",
        "batch_id",
        "events"
      ],
      "additionalProperties": false
    },
    "StateQuery": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "event_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          }
        }
      },
      "required": [
        "protocol_version",
        "event_ids"
      ],
      "additionalProperties": false
    },
    "StreamStateQuery": {
      "type": "object",
      "properties": {
        "protocol_version": {
          "const": 1
        },
        "previous_host_id": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "protocol_version",
        "previous_host_id"
      ],
      "additionalProperties": false
    },
    "SnapshotDescriptor": {
      "type": "object",
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 524288
        },
        "maps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        }
      },
      "required": [
        "index",
        "sha256",
        "bytes",
        "maps"
      ],
      "additionalProperties": false
    },
    "SnapshotManifest": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "format": {
          "const": 1
        },
        "protocol_version": {
          "const": 1
        },
        "scheme": {
          "const": "canonical-map-v1"
        },
        "server_epoch": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "watermark": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "policy_watermark": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "generated_at": {
          "type": "number",
          "minimum": 0
        },
        "maps": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "pages": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/SnapshotDescriptor"
          }
        },
        "content_id": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "ok",
        "format",
        "protocol_version",
        "scheme",
        "server_epoch",
        "watermark",
        "policy_watermark",
        "generated_at",
        "maps",
        "pages",
        "content_id"
      ],
      "additionalProperties": false,
      "description": "Runtime additionally verifies canonical JSON SHA256 content identity, contiguous descriptor indexes, map totals and policy_watermark <= watermark."
    },
    "SnapshotRow": {
      "type": "object",
      "properties": {
        "beatmap_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "good": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "bad": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "neutral": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "beatmap_id",
        "good",
        "bad",
        "neutral"
      ],
      "additionalProperties": false
    },
    "SnapshotPage": {
      "type": "object",
      "properties": {
        "ok": {
          "const": true
        },
        "format": {
          "const": 1
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 199
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 500,
          "items": {
            "$ref": "#/$defs/SnapshotRow"
          }
        }
      },
      "required": [
        "ok",
        "format",
        "index",
        "rows"
      ],
      "additionalProperties": false,
      "description": "Runtime additionally verifies byte count, canonical JSON SHA256, descriptor identity and globally strictly increasing beatmap IDs."
    },
    "EpochReviewInput": {
      "type": "object",
      "properties": {
        "expected_profile_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "expected_new_epoch": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "acknowledge_quarantined_backlog": {
          "const": true
        }
      },
      "required": [
        "expected_profile_sha256",
        "expected_new_epoch",
        "acknowledge_quarantined_backlog"
      ],
      "additionalProperties": false
    }
  }
}
